---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD nodes (e.g. FAQPage) merged into the page @graph */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

// Domaine actuel + ancien domaine (migration qalive.ink -> qalive.online)
const siteUrl = (import.meta.env.SITE || "https://qalive.online").replace(
  /\/$/,
  "",
);
const legacyDomain = "qalive.ink";
const legacyUrl = `https://${legacyDomain}`;
const appUrl = "https://app.qalive.online";

// SEO : Titre optimisé pour l'intention de recherche (Keyword + Value Prop)
const defaultTitle =
  "QAlive – Free Live Q&A Platform for Events & Webinars | No Login Required";

// SEO : Description orientée "Action" et "Solution" (Max 160 caractères pour éviter la coupure)
const defaultDescription =
  "Free live Q&A tool for conferences, workshops & town halls. Join via QR code, ask anonymous questions, no signup. qalive.online (formerly qalive.ink).";

// SEO : Mots-clés (Google les ignore un peu, mais utile pour Bing/Yandex)
const pageKeywords =
  "live Q&A, audience engagement tool, free slido alternative, interactive presentation software, anonymous questions, event q&a, webinar tools, qalive, qalive.online, qalive.ink";

const {
  title = defaultTitle,
  description = defaultDescription,
  schema = [],
  noindex = false,
} = Astro.props;

// Canonical propre par page, aligné sur le format du sitemap (slash final)
const pathname = Astro.url.pathname.replace(/\/?$/, "/");
const canonicalUrl = `${siteUrl}${pathname}`;
const pageImage = `${siteUrl}/images/og-image.png`;
const logoUrl = `${siteUrl}/images/qalive-new-logo.svg`;

const author = {
  "@type": "Person",
  "@id": `${siteUrl}/#author`,
  name: "Christian Ludovic Talekeufouet",
  url: "https://github.com/talchrist",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "QAlive",
      alternateName: ["QALive", "Qalive", "qalive.online", legacyDomain],
      url: `${siteUrl}/`,
      logo: { "@type": "ImageObject", url: logoUrl },
      email: "talchrist10@gmail.com",
      founder: { "@id": `${siteUrl}/#author` },
      description: `QAlive is a free live Q&A platform for events. Official website: qalive.online (previously ${legacyDomain}).`,
      sameAs: ["https://x.com/qalive", legacyUrl],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      name: "QAlive",
      alternateName: ["qalive.online", legacyDomain],
      url: `${siteUrl}/`,
      inLanguage: "en",
      publisher: { "@id": `${siteUrl}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": `${siteUrl}/#website` },
      about: { "@id": `${siteUrl}/#software` },
      primaryImageOfPage: { "@type": "ImageObject", url: pageImage },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      name: "QAlive",
      alternateName: ["QALive", "qalive.online", legacyDomain],
      headline: "Interactive Live Q&A Platform",
      description: defaultDescription,
      disambiguatingDescription: `QAlive moved from ${legacyDomain} to qalive.online. Both refer to the same product; qalive.online is the official domain.`,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web, iOS, Android",
      url: `${siteUrl}/`,
      installUrl: appUrl,
      image: pageImage,
      screenshot: pageImage,
      offers: [
        {
          "@type": "Offer",
          name: "Starter",
          price: "0",
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
        },
        {
          "@type": "Offer",
          name: "Pro",
          price: "12.99",
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
        },
      ],
      featureList: [
        "Live Q&A",
        "QR Code Generation",
        "Moderation Dashboard",
        "Anonymous Submissions",
        "No signup for attendees",
      ],
      author,
      publisher: { "@id": `${siteUrl}/#organization` },
    },
    author,
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="Christian Ludovic Talekeufouet" />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#E85D4A" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="preconnect" href={appUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:image:alt" content="QAlive live Q&A dashboard preview" />
    <meta property="og:site_name" content="QAlive" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@qalive" />
    <meta name="twitter:creator" content="@qalive" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageImage} />
    <meta
      name="twitter:image:alt"
      content="QAlive live Q&A dashboard preview"
    />

    <link rel="icon" type="image/svg+xml" href="/images/qalive-new-logo.svg" />
    <link rel="apple-touch-icon" href="/images/qalive-new-logo.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script async src="https://plausible.io/js/pa-8kQzrLfQBEL26SjfGr8jG.js"
    ></script>

    <script>
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          }));
      plausible.init();
    </script>
  </head>
  <body class="font-mabry antialiased bg-white text-black">
    <div>
      <slot />
    </div>
  </body>
</html>
