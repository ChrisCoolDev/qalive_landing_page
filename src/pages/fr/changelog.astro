---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getChangelogEntries } from "../../lib/notion";

const entries = await getChangelogEntries('FR');
---

<Layout
  title="Changelog – QAlive | Notes de Version & Mises à Jour"
  description="Suivez l'historique complet des nouveautés, améliorations et corrections apportées à QAlive."
>
  <Header currentLang="FR" currentPath="/fr/changelog" />

  <main class="min-h-screen bg-[#FAF9F5] py-12 md:py-16">
    <div class="mx-auto max-w-[800px] px-6">
      <!-- En-tête Changelog -->
      <div class="mb-14 text-center space-y-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#E85D4A]">Changelog</span>
        <h1 class="text-3xl md:text-5xl font-bold text-[#161924]">Nouveautés de QAlive</h1>
        <p class="text-gray-600 text-sm md:text-base max-w-md mx-auto">
          Toutes les fonctionnalités, améliorations et corrections déployées en production.
        </p>
      </div>

      <!-- Timeline des versions -->
      <div class="relative border-l border-gray-200 ml-4 md:ml-32 space-y-12">
        {entries.map((entry) => (
          <div class="relative pl-6 md:pl-10">
            <!-- Puce sur la timeline -->
            <div class="absolute -left-2 top-1.5 w-4 h-4 rounded-full bg-[#E85D4A] border-4 border-white shadow-sm"></div>

            <!-- Date & Version en colonne gauche sur écran large -->
            <div class="md:absolute md:-left-36 md:top-0 md:text-right md:w-28 space-y-0.5">
              <span class="inline-block text-xs font-bold text-[#161924] bg-[#F6F5EF] px-2 py-0.5 rounded border border-gray-200 font-mono">
                {entry.version}
              </span>
              <time datetime={entry.date} class="block text-xs text-gray-500">
                {new Date(entry.date).toLocaleDateString('fr-FR', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            </div>

            <!-- Carte de release -->
            <div class="bg-white rounded-xl p-6 md:p-8 border border-[#E6E6E6] shadow-sm space-y-4">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 pb-3">
                <h2 class="text-lg font-semibold text-[#161924]">
                  {entry.title}
                </h2>
                <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-red-50 text-[#E85D4A] border border-red-100">
                  {entry.type}
                </span>
              </div>

              <!-- Contenu riche du changelog (Markdown / HTML) -->
              <div
                class="prose prose-sm prose-neutral max-w-none prose-a:text-[#E85D4A]"
                set:html={entry.contentHtml}
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>
