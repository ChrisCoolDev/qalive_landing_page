---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getBlogPosts, getPostBySlug } from "../../lib/notion";

export async function getStaticPaths() {
  const posts = await getBlogPosts('EN');
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug, 'EN');

if (!post) {
  return Astro.redirect('/blog');
}
---

<Layout
  title={`${post.title} – QAlive Blog`}
  description={post.excerpt}
>
  <Header currentLang="EN" currentPath={`/blog/${slug}`} />

  <article class="min-h-screen bg-white py-12 md:py-16">
    <div class="mx-auto max-w-[760px] px-6">
      <!-- Fil d'ariane -->
      <nav class="mb-8 text-xs text-gray-500 flex items-center gap-2">
        <a href="/blog" class="hover:text-black">← Back to Blog</a>
        <span>/</span>
        <span class="truncate">{post.title}</span>
      </nav>

      <!-- Titre & Métadonnées -->
      <header class="mb-10 space-y-4">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#161924] leading-tight">
          {post.title}
        </h1>
        <div class="flex items-center gap-3 text-xs text-gray-500 border-b border-gray-100 pb-6">
          <time datetime={post.date}>
            {new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          <span>•</span>
          <span>By QAlive Team</span>
        </div>
      </header>

      <!-- Image de couverture si présente -->
      {post.cover && (
        <div class="mb-10 rounded-xl overflow-hidden border border-[#E6E6E6]">
          <img src={post.cover} alt={post.title} class="w-full h-auto max-h-[420px] object-cover" />
        </div>
      )}

      <!-- Contenu riche converti depuis Notion (H1, H2, H3, Images, Liens, Citations) -->
      <div
        class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:text-[#161924] prose-a:text-[#E85D4A] prose-img:rounded-xl prose-img:border prose-img:border-[#E6E6E6] prose-blockquote:border-l-[#E85D4A] prose-blockquote:text-gray-600 prose-pre:bg-[#161924]"
        set:html={post.contentHtml}
      />

      <!-- Pied d'article CTA -->
      <div class="mt-16 pt-8 border-t border-gray-200 text-center space-y-4 bg-[#FAF9F5] p-8 rounded-2xl">
        <h3 class="text-lg font-semibold text-[#161924]">Try QAlive for your next event</h3>
        <p class="text-xs text-gray-600 max-w-md mx-auto">
          Engage your audience with live questions, real-time reactions and a seamless stage view. Free, no app required.
        </p>
        <a
          href="https://app.qalive.online"
          target="_blank"
          rel="noopener"
          class="inline-block px-5 py-2.5 rounded bg-[#E85D4A] text-xs font-semibold text-white hover:bg-[#d44d3c] transition-colors shadow-sm"
        >
          Get started for free →
        </a>
      </div>
    </div>
  </article>
</Layout>
