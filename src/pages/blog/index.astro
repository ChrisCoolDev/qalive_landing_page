---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getBlogPosts } from "../../lib/notion";

const posts = await getBlogPosts('EN');
---

<Layout
  title="Blog – QAlive | Interactive Presentations & Product Updates"
  description="Discover insights on modern presentation tech, audience engagement, and how we are building QAlive in public."
>
  <Header currentLang="EN" currentPath="/blog" />

  <main class="min-h-screen bg-[#FAF9F5] py-12 md:py-16">
    <div class="mx-auto max-w-[860px] px-6">
      <!-- En-tête du Blog -->
      <div class="mb-12 text-center space-y-3">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#E85D4A]">QAlive Blog</span>
        <h1 class="text-3xl md:text-5xl font-bold text-[#161924]">Behind the scenes &amp; thoughts</h1>
        <p class="text-gray-600 text-sm md:text-base max-w-lg mx-auto">
          Articles on live presentations, real-time engagement, and building a lightweight product.
        </p>
      </div>

      <!-- Liste des articles -->
      {posts.length === 0 ? (
        <div class="bg-white rounded-xl p-12 text-center border border-[#E6E6E6]">
          <p class="text-gray-500 text-sm">No published articles yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {posts.map((post) => (
            <article class="bg-white rounded-xl border border-[#E6E6E6] overflow-hidden hover:shadow-md hover:border-gray-300 transition-all flex flex-col justify-between">
              {post.cover && (
                <img
                  src={post.cover}
                  alt={post.title}
                  class="w-full h-44 object-cover border-b border-[#E6E6E6]"
                />
              )}
              <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <div class="flex items-center gap-2 text-xs text-gray-400">
                    <time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                  </div>
                  <h2 class="text-lg font-semibold text-[#161924] leading-snug hover:text-[#E85D4A] transition-colors">
                    <a href={`/blog/${post.slug}`}>{post.title}</a>
                  </h2>
                  {post.excerpt && (
                    <p class="text-xs md:text-sm text-gray-600 line-clamp-3 leading-relaxed">
                      {post.excerpt}
                    </p>
                  )}
                </div>

                <div class="pt-2">
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-xs font-semibold text-[#E85D4A] hover:underline inline-flex items-center gap-1"
                  >
                    Read article <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </main>
</Layout>
