---
interface Props {
  currentPath?: string;
}

const { currentPath = '/blog' } = Astro.props;
const isBlog = currentPath.includes('/blog');
---

<header class="border-b border-[#E6E6E6] bg-white sticky top-0 z-50">
  <div class="mx-auto max-w-[950px] px-6 sm:px-8">
    <div class="flex h-[52px] items-center justify-between">
      <a class="flex items-center gap-1.5 tracking-tight" href="/" aria-label="QAlive home">
        <img
          src="/images/qalive-new-logo.svg"
          alt="QAlive logo"
          width="20"
          height="20"
          class="w-5 h-5"
        />
        <span class="text-sm font-medium">QAlive</span>
      </a>

      <nav class="hidden md:flex items-center gap-8">
        <a class="text-sm tracking-tight text-[#555] transition-colors hover:text-black hover:underline underline-offset-4" href="/#features">
          Features
        </a>
        <a class="text-sm tracking-tight text-[#555] transition-colors hover:text-black hover:underline underline-offset-4" href="/#pricing">
          Pricing
        </a>
        <a
          class="text-sm tracking-tight text-[#555] transition-colors hover:text-black hover:underline underline-offset-4"
          href="https://blog.qalive.online"
        >
          Blog
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Login Button -->
        <a href="https://app.qalive.online" target="_blank" rel="noopener">
          <button class="h-7 w-12 sm:w-16 rounded bg-[#E85D4A] text-[12px] text-white hover:bg-[#E85D4A]/90 transition-colors font-medium">
            Login
          </button>
        </a>
      </div>
    </div>
  </div>
</header>
