---
---

<footer class="border-t border-[#E6E6E6] bg-[#FBFBFA] py-12 px-6 sm:px-8 mt-16">
  <div class="mx-auto max-w-[950px]">
    <div class="mb-8 flex flex-col gap-8 md:gap-12 lg:flex-row lg:justify-between">
      <div class="flex items-start justify-between w-full">
        <div>
          <a class="flex items-center gap-1 tracking-tight" href="/">
            <img
              src="/images/qalive-new-logo.svg"
              alt="QAlive logo"
              class="w-5 h-5"
            />
            <span class="text-sm font-medium">QAlive</span>
          </a>
          <p class="text-[12px] text-[#555] tracking-tight max-w-[280px] leading-relaxed mt-2">
            Interactive Q&A for every event. Engage your audience in real-time.
          </p>
          <div class="mt-3">
            <a
              href="mailto:talchrist10@gmail.com"
              class="text-[11px] text-[#555] tracking-tight hover:text-[#0A0A0A] transition-colors underline decoration-1 underline-offset-2"
            >
              Contact the creator
            </a>
          </div>
        </div>
        <div class="flex items-start space-x-12 sm:space-x-16">
          <div class="flex flex-col gap-2">
            <p class="text-[13px] font-medium text-[#0A0A0A] mb-1">
              Product
            </p>
            <a
              class="text-[13px] text-[#555] tracking-tight hover:text-[#0A0A0A] transition-colors whitespace-nowrap"
              href="/#pricing"
            >
              Pricing
            </a>
            <a
              class="text-[13px] text-[#555] tracking-tight hover:text-[#0A0A0A] transition-colors whitespace-nowrap"
              href="/#features"
            >
              Features
            </a>
            <a
              class="text-[13px] text-[#555] tracking-tight hover:text-[#0A0A0A] transition-colors whitespace-nowrap"
              href="https://blog.qalive.online"
            >
              Blog
            </a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              class="text-[13px] text-[#555] tracking-tight hover:text-[#0A0A0A] transition-colors whitespace-nowrap"
              href="https://app.qalive.online"
            >
              Live demo
            </a>
          </div>
          <div class="flex flex-col gap-2">
            <p class="text-[13px] font-medium text-[#0A0A0A] mb-1">
              Legal
            </p>
            <a
              class="text-[13px] text-[#555] tracking-tight hover:text-[#0A0A0A] transition-colors"
              href="/privacy"
            >
              Privacy
            </a>
            <a
              class="text-[13px] text-[#555] tracking-tight hover:text-[#0A0A0A] transition-colors"
              href="/terms"
            >
              Terms
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-[#E6E6E6] pt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="text-[11px] text-[#737373] tracking-tight">
        © {new Date().getFullYear()} QAlive · qalive.online. Built with ❤️ for better events.
      </p>
      <div class="flex items-center gap-4">
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#555] hover:text-[#0A0A0A] transition-colors"
          aria-label="Follow us on X"
          href="https://x.com/qalive"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="fill-current"
          >
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-8">
      <p class="text-[11px] leading-relaxed text-[#737373] opacity-60 tracking-tight max-w-[720px] mx-auto text-center">
        QAlive is an independent project built to make event Q&A sessions more interactive and accessible. All features are provided as-is. We continuously improve based on user feedback.
      </p>
    </div>
  </div>
</footer>
